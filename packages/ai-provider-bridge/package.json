{
  "name": "ai-provider-bridge",
  "version": "0.1.0",
  "description": "Platform-neutral provider infrastructure: registry, model clients, and credential access abstractions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./local-providers": {
      "types": "./dist/local-providers.d.ts",
      "import": "./dist/local-providers.js",
      "default": "./dist/local-providers.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "default": "./dist/providers.js"
    },
    "./positron": {
      "types": "./dist/positron/index.d.ts",
      "import": "./dist/positron/index.js",
      "default": "./dist/positron/index.js"
    },
    "./credential-shaping": {
      "types": "./dist/credential-shaping.d.ts",
      "import": "./dist/credential-shaping.js",
      "default": "./dist/credential-shaping.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build-coordinator.ts --clean",
    "build:unbundled": "tsc -p .",
    "watch": "tsx scripts/build-coordinator.ts --watch",
    "clean": "rm -rf dist .bridge-watch tsconfig.tsbuildinfo",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:build-coordinator": "vitest run -c vitest.build-coordinator.config.ts",
    "test:watch": "vitest",
    "lint": "oxlint -c oxlint.config.json src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "hygiene": "tsx scripts/hygiene.ts",
    "precommit": "lint-staged",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,md}": [
      "oxfmt --check --no-error-on-unmatched-pattern",
      "tsx scripts/hygiene.ts"
    ]
  },
  "dependencies": {
    "ai-config": "*",
    "ai-credentials": "*",
    "@ai-sdk/amazon-bedrock": "^5.0.113",
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/deepseek": "^3.0.63",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/google-vertex": "^5.0.109",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@aws-sdk/client-bedrock": "^3.981.0",
    "@aws-sdk/credential-providers": "^3.981.0",
    "@smithy/core": "^3.25.1",
    "aws4fetch": "^1.0.20",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@azure/identity": "^4.13.1",
    "ai": "^7.0.137",
    "ai-sdk-ollama": "^4.4.0",
    "google-auth-library": "^10.5.0"
  },
  "peerDependencies": {
    "vscode": "^1.100.0"
  },
  "peerDependenciesMeta": {
    "vscode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@smithy/eventstream-codec": "^4.3.3",
    "@smithy/util-utf8": "^4.3.3",
    "@types/node": "22.x",
    "@types/positron-vscode": "npm:@types/vscode@^1.100.0",
    "ai": "^7.0.137",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.1",
    "whatwg-fetch": "^3.6.20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/posit-dev/ai-provider-bridge",
    "directory": "packages/ai-provider-bridge"
  },
  "license": "MIT"
}
